{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cargo",
            "command": "build",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "cargo build (Debug)"
        },
        {
            "type": "cargo",
            "command": "build",
            "args": ["--release"],
            "problemMatcher": ["$rustc"],
            "label": "cargo build (Release)"
        },
        {
            "type": "cargo",
            "command": "check",
            "problemMatcher": ["$rustc"],
            "label": "cargo check"
        },
        {
            "type": "cargo",
            "command": "clippy",
            "problemMatcher": ["$rustc"],
            "label": "cargo clippy"
        },
        {
            "type": "cargo",
            "command": "test",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "label": "cargo test"
        },
        {
            "type": "cargo",
            "command": "run",
            "args": ["--bin=thme-gui"],
            "problemMatcher": ["$rustc"],
            "label": "Launch THME Native Desktop Studio"
        },
        {
            "type": "cargo",
            "command": "run",
            "args": ["--example=generate_mock_model"],
            "problemMatcher": ["$rustc"],
            "label": "Generate Mock Model"
        }
    ]
}
